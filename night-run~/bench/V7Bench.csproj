<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Internal/Transport/*.cs" Link="T/%(Filename)%(Extension)" />
    <Compile Include="../../Runtime/Internal/AndroidQueueBridge.cs" Link="T/AndroidQueueBridge.cs" />
    <Compile Include="Program.cs" /><Compile Include="Profile.cs" />
  </ItemGroup>
</Project>
