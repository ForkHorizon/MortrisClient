# ProjectMem runtime and derived state (configuration and curated map/plan stay tracked)
/.projectmem/events.jsonl
/.projectmem/issues/
/.projectmem/summary.md
/.projectmem/structure.json
/.projectmem/watch.pid
/.projectmem/watch.log
/.projectmem/CLAUDE.md

# Local Serena state
/.serena/cache/
/.serena/project.local.yml

# Graphify output is regenerated locally.
/graphify-out/*
/graphify-out.meta

# Android AAR build state
/Native~/android/.gradle/
/Native~/android/**/build/
/Native~/android/local.properties

# Local MCP connection files can contain credentials.
/.mcp.json
/.mcp.json.bak-*
