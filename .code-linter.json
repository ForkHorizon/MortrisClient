{
  "max_file_lines": 600,
  "max_function_lines": 80,
  "max_nesting_depth": 6,
  "max_parameters": 8,
  "max_comment_lines": 20,
  "max_types_per_file": 5,
  "include_extensions": [
    ".cs",
    ".java"
  ],
  "ignore": [
    ".ci-gates",
    ".git",
    "Native~",
    "Samples~",
    "*.meta"
  ]
}
